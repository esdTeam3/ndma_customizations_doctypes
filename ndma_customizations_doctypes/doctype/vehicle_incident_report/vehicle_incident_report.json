{
 "doctype": "DocType",
 "name": "Vehicle Incident Report",
 "module": "NDMA Customizations",
 "custom": 1,
 "is_submittable": 1,
 "engine": "InnoDB",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "field_order": [
  "naming_series",
  "vehicle",
  "driver",
  "reported_by",
  "column_break_1",
  "incident_date",
  "location",
  "section_break_1",
  "damage_description",
  "police_report_filed",
  "police_station",
  "column_break_2",
  "status",
  "fleet_manager_verification",
  "dgm_operations_signoff",
  "section_break_2",
  "photos"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "VIR-.YYYY.-",
   "reqd": 1,
   "print_hide": 1
  },
  {
   "fieldname": "vehicle",
   "fieldtype": "Data",
   "label": "Vehicle (Plate / Model)",
   "reqd": 1,
   "in_list_view": 1,
   "description": "Consider Link to the stock 'Vehicle' DocType (Assets module) instead of free text if fleet records already exist there."
  },
  {
   "fieldname": "driver",
   "fieldtype": "Data",
   "label": "Driver",
   "reqd": 1
  },
  {
   "fieldname": "reported_by",
   "fieldtype": "Link",
   "label": "Reported By",
   "options": "User",
   "default": "user",
   "read_only": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "incident_date",
   "fieldtype": "Date",
   "label": "Date",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "location",
   "fieldtype": "Data",
   "label": "Location",
   "reqd": 1
  },
  {
   "fieldname": "section_break_1",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "damage_description",
   "fieldtype": "Small Text",
   "label": "Damage Description",
   "reqd": 1
  },
  {
   "fieldname": "police_report_filed",
   "fieldtype": "Check",
   "label": "Police Report Filed"
  },
  {
   "fieldname": "police_station",
   "fieldtype": "Data",
   "label": "Police Station",
   "depends_on": "eval:doc.police_report_filed==1"
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nPending Verification\nPending DGM\nClosed\nRejected",
   "default": "Draft",
    "allow_on_submit": 1,
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "ASSUMPTION: Reporter -> Fleet Manager verifies -> DGM (Operations) - NDMA signs off (matches Approvals workspace showing VIR at executive tier). Confirm DGM (Operations), not (Admin), is correct here."
  },
  {
   "fieldname": "fleet_manager_verification",
   "fieldtype": "Small Text",
   "label": "Fleet Manager Verification Notes"
  },
  {
   "fieldname": "dgm_operations_signoff",
   "fieldtype": "Small Text",
   "label": "DGM (Operations) Remarks"
  },
  {
   "fieldname": "section_break_2",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "photos",
   "fieldtype": "Attach",
   "label": "Attach Photos"
  }
 ],
 "permissions": [
  {
   "role": "Employee - NDMA",
    "read": 1, "write": 1, "create": 1, "submit": 1, "delete": 0, "if_owner": 1
  },
  {
   "role": "Fleet Manager",
    "read": 1, "write": 1, "create": 1, "submit": 1, "cancel": 1, "delete": 0, "report": 1
  },
  {
   "role": "DGM (Operations) - NDMA",
    "read": 1, "write": 1, "create": 0, "submit": 1, "cancel": 1, "delete": 0, "report": 1
  },
  {
   "role": "Facilities Manager",
   "read": 1, "write": 1, "create": 0, "delete": 0, "report": 1
  },
  {
   "role": "System Manager",
   "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "print": 1, "email": 1, "share": 1
  }
 ]
}
