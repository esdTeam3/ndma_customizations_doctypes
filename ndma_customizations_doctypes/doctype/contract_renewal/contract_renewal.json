{
 "doctype": "DocType",
 "name": "Contract Renewal",
 "module": "NDMA Customizations",
 "custom": 1,
 "is_submittable": 0,
 "engine": "InnoDB",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "field_order": [
  "naming_series",
  "employee",
  "employee_name",
  "position",
  "department",
  "column_break_1",
  "current_contract_end",
  "proposed_term",
  "proposed_start_date",
  "section_break_1",
  "manager_recommendation",
  "hr_recommendation",
  "gm_endorsement_notes",
  "hr_processing_notes",
  "gm_final_remarks",
  "column_break_2",
  "status",
  "gm_approver",
  "section_break_2",
  "attach_appraisal"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "HR-CTR-.YYYY.-",
   "reqd": 1,
   "print_hide": 1
  },
  {
   "fieldname": "employee",
   "fieldtype": "Link",
   "label": "Employee",
   "options": "Employee",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "employee_name",
   "fieldtype": "Data",
   "label": "Employee Name",
   "fetch_from": "employee.employee_name",
   "read_only": 1
  },
  {
   "fieldname": "position",
   "fieldtype": "Data",
   "label": "Position",
   "fetch_from": "employee.designation",
   "in_list_view": 1
  },
  {
   "fieldname": "department",
   "fieldtype": "Link",
   "label": "Department",
   "options": "Department",
   "fetch_from": "employee.department",
   "read_only": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "current_contract_end",
   "fieldtype": "Date",
   "label": "Current Contract End Date",
   "reqd": 1
  },
  {
   "fieldname": "proposed_term",
   "fieldtype": "Select",
   "label": "Proposed Term",
   "options": "6 months\n1 year\n2 years\n3 years\nPermanent",
   "reqd": 1
  },
  {
   "fieldname": "proposed_start_date",
   "fieldtype": "Date",
   "label": "Proposed New Term Start Date"
  },
  {
   "fieldname": "section_break_1",
   "fieldtype": "Section Break",
   "label": "Approval Trail"
  },
  {
   "fieldname": "manager_recommendation",
   "fieldtype": "Small Text",
   "label": "Manager Recommendation",
    "permlevel": 1,
   "description": "Confirmed chain: Employee -> Manager -> HR -> GM (endorsement) -> HR (processing) -> GM (final approval)."
  },
  {
   "fieldname": "hr_recommendation",
   "fieldtype": "Small Text",
    "label": "HR Recommendation (1st pass)",
    "permlevel": 2
  },
  {
   "fieldname": "gm_endorsement_notes",
   "fieldtype": "Small Text",
    "label": "GM Endorsement Notes (1st pass)",
    "permlevel": 3
  },
  {
   "fieldname": "hr_processing_notes",
   "fieldtype": "Small Text",
   "label": "HR Processing Notes (2nd pass)",
    "permlevel": 2,
   "description": "Filled in after GM's initial endorsement, e.g. drafting the actual renewal contract for GM's final sign-off."
  },
  {
   "fieldname": "gm_final_remarks",
   "fieldtype": "Small Text",
    "label": "GM Final Approval Remarks (2nd pass)",
    "permlevel": 3
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nPending Manager\nPending HR Review\nPending GM Endorsement\nPending HR Processing\nPending GM Final Approval\nApproved\nRejected",
   "default": "Draft",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Confirmed chain: Employee -> Manager -> HR -> GM -> HR -> GM (final). Modeled as two distinct HR states and two distinct GM states since Frappe Workflow states must be unique per DocType."
  },
  {
   "fieldname": "gm_approver",
   "fieldtype": "Link",
   "label": "GM Approver",
   "options": "User",
   "read_only": 1,
   "description": "Expected to resolve to a user with the General Manager role."
  },
  {
   "fieldname": "section_break_2",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "attach_appraisal",
   "fieldtype": "Attach",
   "label": "Attach Latest Appraisal"
  }
 ],
 "permissions": [
  {
   "role": "HR User",
   "read": 1, "write": 1, "create": 1, "delete": 0, "report": 1
  },
