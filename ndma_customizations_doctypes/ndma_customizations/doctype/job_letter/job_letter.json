{
 "doctype": "DocType",
 "name": "Job Letter",
 "module": "NDMA Customizations",
 "custom": 1,
 "is_submittable": 0,
 "engine": "InnoDB",
 "autoname": "naming_series:",
 "naming_rule": "By \"Naming Series\" field",
 "track_changes": 1,
 "sort_field": "modified",
 "sort_order": "DESC",
 "field_order": [
  "naming_series",
  "employee",
  "employee_name",
  "department",
  "column_break_1",
  "letter_type",
  "addressed_to",
  "purpose",
  "section_break_1",
  "requested_on",
  "issued_on",
  "column_break_2",
  "status",
  "manager_approver",
  "issued_by",
  "section_break_2",
  "manager_remarks",
  "letter_attachment"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "fieldtype": "Select",
   "label": "Series",
   "options": "HR-JBL-.YYYY.-",
   "reqd": 1,
   "print_hide": 1
  },
  {
   "fieldname": "employee",
   "fieldtype": "Link",
   "label": "Employee",
   "options": "Employee",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "employee_name",
   "fieldtype": "Data",
   "label": "Employee Name",
   "fetch_from": "employee.employee_name",
   "read_only": 1
  },
  {
   "fieldname": "department",
   "fieldtype": "Link",
   "label": "Department",
   "options": "Department",
   "fetch_from": "employee.department",
   "read_only": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "letter_type",
   "fieldtype": "Select",
   "label": "Letter Type",
   "options": "Employment Confirmation\nEmployment + Salary Confirmation\nReference Letter\nOther",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "addressed_to",
   "fieldtype": "Data",
   "label": "Addressed To",
   "reqd": 1
  },
  {
   "fieldname": "purpose",
   "fieldtype": "Small Text",
   "label": "Purpose / Notes"
  },
  {
   "fieldname": "section_break_1",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "requested_on",
   "fieldtype": "Date",
   "label": "Requested On",
   "default": "Today",
   "read_only": 1
  },
  {
   "fieldname": "issued_on",
   "fieldtype": "Date",
   "label": "Issued On",
   "read_only": 1
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nPending Manager\nPending HR\nCompleted\nRejected",
   "default": "Draft",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Confirmed chain: Employee -> Manager -> HR (final, issues letter)."
  },
  {
   "fieldname": "manager_approver",
   "fieldtype": "Link",
   "label": "Manager Approver",
   "options": "User",
   "read_only": 1,
   "description": "Expected to auto-resolve from Employee > Reporting Manager."
  },
  {
   "fieldname": "issued_by",
   "fieldtype": "Link",
   "label": "Issued By (HR)",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "section_break_2",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "manager_remarks",
   "fieldtype": "Small Text",
    "label": "Manager Remarks",
    "permlevel": 1
  },
  {
   "fieldname": "letter_attachment",
   "fieldtype": "Attach",
   "label": "Attach Final Letter"
  }
 ],
 "permissions": [
  {
   "role": "Employee - NDMA",
    "read": 1, "write": 1, "create": 1, "delete": 0, "if_owner": 1, "report": 1
  },
  {
   "role": "Manager - NDMA",
   "read": 1, "write": 1, "create": 0, "delete": 0, "report": 1
  },
  {
   "role": "HR User",
   "read": 1, "write": 1, "create": 1, "delete": 0, "report": 1
  },
  {
   "role": "HR Manager",
   "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1
  },
  {
   "role": "System Manager",
   "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1, "print": 1, "email": 1, "share": 1
  },
  {
   "role": "Employee - NDMA",
   "permlevel": 1,
   "read": 1, "write": 0
  },
  {
   "role": "Manager - NDMA",
   "permlevel": 1,
   "read": 1, "write": 1
  },
  {
   "role": "Department Manager",
   "permlevel": 1,
    "read": 1, "write": 0
  },
  {
   "role": "HR User",
   "permlevel": 1,
    "read": 1, "write": 0
  },
  {
   "role": "HR Manager",
   "permlevel": 1,
    "read": 1, "write": 0
  },
  {
   "role": "System Manager",
   "permlevel": 1,
   "read": 1, "write": 1
  }
 ]
}
